{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
<div class="card">
    <h1>Connexion</h1>
    {% if error %}
        <div class="alert alert-error">
            {{ error.messageKey|trans(error.messageData, 'security') }}
        </div>
    {% endif %}
    <form method="post">
        <label for="username">E-mail</label>
        <input type="email" id="username" name="_username" value="{{ last_username }}" required autofocus>
        <label for="password">Mot de passe</label>
        <input type="password" id="password" name="_password" required>
        <button type="submit">Se connecter</button>
    </form>
    <p>Pas de compte ? <a href="{{ path('app_register_client') }}">Inscription client</a> ·
       <a href="{{ path('app_register_commerce') }}">Inscription commerce</a></p>
</div>
{% endblock %}